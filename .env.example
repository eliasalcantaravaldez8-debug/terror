# ───── NEXPLAY — configuração (copie para .env) ─────
# Portas do app principal e da origem isolada que executa os jogos.
PORT=3000
SANDBOX_PORT=3001
# Em produção, use DOIS domínios diferentes (ex.: https://nexplay.com e https://nexplay-games.net).
APP_ORIGIN=http://localhost:5173
SANDBOX_ORIGIN=http://localhost:3001
# 1 = cada jogo em seu próprio subdomínio (g<ID>.<sandbox>) — requer DNS curinga + TLS curinga.
SANDBOX_GAME_SUBDOMAINS=0
TRUST_PROXY=0
DATA_DIR=storage
# Segredo para tokens de jogo (se vazio, é gerado em storage/.play-secret).
PLAY_TOKEN_SECRET=

# ───── E-mail (cadastro e recuperação de conta) ─────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="NEXPLAY <no-reply@seu-dominio.com>"

# ───── NEXPLAY AI (Claude, Anthropic) ─────
ANTHROPIC_API_KEY=
NEXPLAY_AI_MODEL=claude-opus-5-5

# ───── Pagamentos (Stripe) — deixe vazio para manter pagamentos desativados ─────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_DELUXE=

# ───── Limites ─────
MAX_GAME_UPLOAD_MB=200
MAX_ASSET_UPLOAD_MB=50
MAX_SIGNUPS_PER_IP_PER_DAY=3

# ───── NEXPLAY FORGE (linha de produção de assets 2D/3D) ─────
# Geração 3D por IA (cada geração consome créditos da SUA conta no provedor).
TRIPO_API_KEY=
TRIPO_API_BASE=https://api.tripo3d.ai/v2/openapi
MESHY_API_KEY=
MESHY_API_BASE=https://api.meshy.ai/openapi
# Blender headless: binário (BLENDER_PATH=/usr/bin/blender) OU Python com o módulo bpy (pip install bpy).
BLENDER_PATH=
NEXPLAY_BPY_PYTHON=
# Jobs simultâneos de produção nesta instância.
FORGE_PARALLEL=2

# ───── Demonstração em uma única porta ─────
# 1 = serve os jogos no mesmo host (/p, /runtime) em iframe de ORIGEM OPACA. Útil para pré-visualizações
# e testes rápidos. Em produção pública, prefira dois domínios (isolamento mais forte e localStorage nos jogos).
SINGLE_ORIGIN=0

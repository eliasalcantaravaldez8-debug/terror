{
  "name": "nexplay",
  "version": "0.1.0",
  "private": true,
  "description": "NEXPLAY — plataforma de jogos, comunidade gamer e criação de jogos com IA",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite --config client/vite.config.js",
    "build": "vite build --config client/vite.config.js && vite build --config client/vite.runtime.config.js",
    "start": "NODE_ENV=production node server/index.js",
    "seed:admin": "node scripts/create-admin.js",
    "test": "node --test tests/*.test.js",
    "build:demo": "vite build --config client/vite.demo.config.js && node scripts/build-demo.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.7.0",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "adm-zip": "^0.6.1",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "meshoptimizer": "^1.3.0",
    "multer": "^2.0.2",
    "nodemailer": "^10.4.0",
    "sharp": "^0.35.5",
    "three": "^0.180.0",
    "ws": "^8.18.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.8.0",
    "vite": "^7.1.0"
  }
}
